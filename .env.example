# ╔══════════════════════════════════════════════════════════════════════════╗
# ║           MARGIN402 — Environment Configuration Template               ║
# ║        Copy to .env and fill in your real values before running        ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Server Ports ─────────────────────────────────────────────────────────────
PORT=3000
VENDORS_PORT=3001

# ── Algorand Testnet Treasury Wallet ─────────────────────────────────────────
# Your Algorand Testnet wallet address (Algorand standard base32 format)
# Example: ABCDEFGHIJKLMNOPQRSTUVWXYZ234567ABCDEFGHIJKLMNOPQRSTUVWXYZ234567AB
TREASURY_WALLET_ADDRESS=

# Your Algorand wallet mnemonic (25 space-separated words from AlgoKit, MyAlgo, etc.)
# IMPORTANT: Use a TESTNET wallet. Fund it with USDC (ASA 10458941) via the testnet dispenser.
# Dispenser: https://testnet.algoexplorer.io/dispenser
# USDC Testnet opt-in required via: algokit dispense or AlgoExplorer
TREASURY_MNEMONIC=

# ── Triple-Brain AI Inference (All Free-Tier) ────────────────────────────────
# BRAIN 1 — Primary: Groq (ultra-fast, free tier)
# Get key: https://console.groq.com
GROQ_API_KEY=

# BRAIN 2 — Secondary: Google Gemini (AI Studio OpenAI compat layer)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# BRAIN 3 — Tertiary: OpenRouter (aggregated free model routing)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── x402 Protocol Configuration ──────────────────────────────────────────────
# GoPlausible facilitator for Algorand x402 payment verification & settlement
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Algorand Testnet CAIP-2 chain identifier (do not change)
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Testnet USDC ASA ID (do not change)
USDC_ASSET_ID=10458941

# ── Hackathon Fail-Safe Mode ──────────────────────────────────────────────────
# Set to "true" to run the full logical demo WITHOUT real blockchain transactions.
# Simulates 2-second payment delays, generates mock TX IDs (TX_ALGO_XXXXXX).
# CRITICAL: Toggle this to true if venue Wi-Fi drops or facilitator is unreachable.
DEMO_MODE=false
