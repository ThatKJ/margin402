# ── Margin402 x402 (Algorand TESTNET) ────────────────────────────────────────
# Testnet per the hackathon's final evaluation criteria (judges verify a real
# x402 transaction on Algorand Testnet via Lora: https://lora.algokit.io/testnet).

# 25-word mnemonic for the custodial server-side treasury wallet.
# Must be a real, funded Algorand TESTNET wallet (free via faucet — small
# amount of ALGO + testnet USDC, opted in to USDC ASA 10458941) before
# running `npm run payment:smoke`.
TREASURY_MNEMONIC=

# GoPlausible facilitator (verifies + settles payments; supports both nets)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Public Algorand testnet algod node (algonode, no key required)
ALGOD_URL=https://testnet-api.algonode.cloud

# Price of the /api/providers/echo smoke-test route, in USD
ECHO_PRICE_USD=0.01

# Hard spend guard — every payment call is checked against these before it runs
SPEND_CAP_PER_JOB_USD=2
SPEND_CAP_PER_HOUR_USD=5

# Demo mode is the safe default: candidate code generation is a pre-verified
# canned response, never a live model call, so an LLM/network failure can't
# take down the demo. Payments, the sandbox verifier, and the economics
# engine are all real either way. Set to "false" to call a live model
# (needs OPENAI_API_KEY below).
DEMO_MODE=true

# Only needed if DEMO_MODE=false
OPENAI_API_KEY=

# Revenue `npm run job:demo` uses for its run — defaults to the canonical
# accepted-counteroffer scenario ($1.20 quote, $1.05 accepted).
JOB_DEMO_REVENUE=1.05

PORT=3000
